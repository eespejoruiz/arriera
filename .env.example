# Copia este archivo a .env y completa los secretos. Nunca subas .env al repositorio.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://arriera:arriera@postgres:5432/arriera
# Genera cada clave con: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CIFRADO_KEY=
DNI_HMAC_KEY=
COOKIE_SEGURA=false
CORS_ORIGINS=["http://localhost:3000"]
# Solo para sembrar usuarios de DATOS DEMO (12+ caracteres, mayúsculas, minúsculas y números)
ARRIERA_DEMO_CLAVE=
# Siguientes sprints
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=arriera
S3_SECRET_KEY=
# OCR: tesseract (local, DATOS DEMO) | azure (prebuilt-read, cuenta y llave del cliente) | ninguno
OCR_PROVEEDOR=tesseract
OCR_IDIOMAS=spa+eng+por
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
